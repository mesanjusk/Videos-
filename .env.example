# =============================================================================
# AI PRODUCTION OS — environment variables
#
# Copy to `.env.local` (Next.js app) and/or `.env` (worker, docker-compose).
# Never commit real secrets. Nothing in this file is a real credential.
#
# Legend:
#   [required]        the app will not start or that feature will not work without it
#   [required-prod]   safe to omit locally, must be set in production
#   [optional]        the feature reports itself unavailable when unset — nothing breaks
#
# A deployment that sets only the [required] block behaves exactly as it did before the merge.
# Every new integration is off by default; see the FEATURE FLAGS section.
# =============================================================================


# ─── APP ─────────────────────────────────────────────────────────────────────
# [required] Canonical URL of the Next.js app. Used by Auth.js for callbacks.
NEXTAUTH_URL=http://localhost:3000
# [required] Session signing key.  openssl rand -base64 32
NEXTAUTH_SECRET=
# [optional] Public base URL used to build local-storage asset URLs.
# Defaults to NEXTAUTH_URL. Set when the worker reaches the app on a different host.
APP_BASE_URL=http://localhost:3000


# ─── DATABASE ────────────────────────────────────────────────────────────────
# [required] MongoDB. Local: mongodb://localhost:27017/ai-production-os
# Production: an Atlas SRV string.
MONGODB_URI=mongodb://localhost:27017/ai-production-os


# ─── REDIS / QUEUE ───────────────────────────────────────────────────────────
# [required] Redis for BullMQ. Local: redis://localhost:6379
# Production: an Upstash rediss:// URL.
REDIS_URL=redis://localhost:6379
# [optional] How long the Vercel serverless queue tick drains for, in ms. Default 45000.
# Keep it comfortably under the function's own timeout.
QUEUE_TICK_BUDGET_MS=45000
# [required-prod, Vercel only] Vercel sends `Authorization: Bearer $CRON_SECRET` on its own Cron
# requests when a project env var of this exact name exists. Without it the cron backstop is open.
CRON_SECRET=
# [optional] Jobs each worker runs concurrently. Default 2. Lower it on a small worker host —
# browser runs are memory-hungry.
WORKER_CONCURRENCY=2
# [optional] Identifies this worker in logs and in the AutomationTask record. Default worker-<pid>.
WORKER_ID=
# [optional] Port the worker's /health endpoint binds. Render and most PaaS hosts inject PORT,
# which takes precedence. Default 4000.
WORKER_PORT=4000


# ─── AUTH ────────────────────────────────────────────────────────────────────
# [required] Google OAuth for app sign-in (Auth.js). Create at console.cloud.google.com.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ─── SECURITY ────────────────────────────────────────────────────────────────
# [required] AES-256-GCM key for every secret at rest: pooled Google account tokens, Instagram
# tokens, browser storage state, workflow credentials, webhook secrets.
#   openssl rand -hex 32
# Losing or rotating this makes existing encrypted rows unreadable — there is no recovery path.
ENCRYPTION_KEY=
# [optional, legacy] The pre-merge name for the same key. ENCRYPTION_KEY is preferred; this is read
# as a fallback so existing deployments keep working without an env change. Set one, not both.
ACCOUNTS_ENCRYPTION_KEY=


# ─── STORAGE ─────────────────────────────────────────────────────────────────
# [optional] "cloudinary" (default) or "local".
# Default is cloudinary so an existing deployment is unaffected. Local disk cannot work on Vercel
# (read-only, ephemeral) and reports itself unavailable there.
STORAGE_PROVIDER=cloudinary
# [required unless STORAGE_PROVIDER=local]
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# [optional] Where LocalStorageProvider writes. Default ./storage/local
LOCAL_STORAGE_DIR=./storage/local


# ─── AI: DEFAULT PROVIDERS ───────────────────────────────────────────────────
# [optional] Bootstrap defaults per capability; overridable per user in Settings and per
# production profile. A provider named here that is not configured reports unavailable.
AI_STORY_PROVIDER=gemini
AI_IMAGE_PROVIDER=gemini
AI_VIDEO_PROVIDER=google-flow
AI_VOICE_PROVIDER=gemini
AI_LIPSYNC_PROVIDER=manual

# [required for Gemini] Only a local-dev fallback — in production each pooled Google account
# carries its own encrypted key (see Account Manager).
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts


# ─── COST POLICY ─────────────────────────────────────────────────────────────
# [optional] Deployment-wide default: ZERO_COST | FREE_PREFERRED | BALANCED | BEST_QUALITY.
# Default BALANCED — the behaviour every existing deployment already has.
#
# ZERO_COST permits only providers verified to cost nothing. A provider whose pricing this codebase
# cannot verify counts as paid, so ZERO_COST will refuse rather than risk a charge. See
# docs/ZERO-COST-MODE.md for what is actually reachable under it.
DEFAULT_COST_POLICY=BALANCED


# ─── FEATURE FLAGS ───────────────────────────────────────────────────────────
# [optional] Every one defaults to the value shown. Changing none of them leaves behaviour
# identical to before the merge.
#
# Whether a run may select ZERO_COST at all. Default true — selecting it is opt-in per run, so
# leaving it available affects nobody who does not ask for it. Set false to forbid it outright.
ENABLE_ZERO_COST_MODE=true
# Each of these fronts a service this deployment may not have. Enabling one without configuring it
# changes nothing except that System Health reports it as "enabled, not configured".
ENABLE_OMNIROUTE=false
ENABLE_VOICEBOX=false
ENABLE_HYPERFRAMES=false
ENABLE_IDEOGRAM=false
ENABLE_LOCAL_AI=false
# Drives Google Flow's website for video generation, since it has no API. ON by default — this is
# how video gets made here; with it off every run stops and waits for a person to do it by hand.
# Needs a connected Flow browser session (Accounts page) before it can do anything.
ENABLE_BROWSER_FALLBACK=true


# ─── OMNIROUTE (optional AI gateway) ─────────────────────────────────────────
# [optional] Any OpenAI-compatible endpoint works here — OmniRoute, vLLM, Ollama's compatible API.
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_DEFAULT_MODEL=auto
# [optional] Comma-separated models YOU have verified cost nothing on your gateway. Only these
# become ZERO_COST-eligible. A gateway's cost is whichever upstream it picks, which this
# application cannot see — so nothing here is assumed free.
OMNIROUTE_ZERO_COST_MODELS=


# ─── VOICEBOX (optional local TTS) ───────────────────────────────────────────
# [optional] The only voice route classified free, and therefore the only one ZERO_COST can use.
VOICEBOX_URL=
VOICEBOX_API_KEY=
VOICEBOX_DEFAULT_SPEAKER=
VOICEBOX_DEFAULT_LANGUAGE=
VOICEBOX_TIMEOUT_MS=120000
# Per-character voices: VOICEBOX_SPEAKER_<CHARACTER_NAME_UPPERCASED>=<speaker-id>
# e.g. VOICEBOX_SPEAKER_ASHA=hi-female-2


# ─── IDEOGRAM (optional image provider) ──────────────────────────────────────
# [optional] Metered. Never reachable under ZERO_COST. Best for text-heavy images —
# title cards, posters, thumbnails, invitations.
IDEOGRAM_API_KEY=
IDEOGRAM_MODEL=V_2
IDEOGRAM_TIMEOUT_MS=120000


# ─── LOCAL AI WORKERS (optional) ─────────────────────────────────────────────
# [optional] Any HTTP service speaking the shape in docs/PROVIDERS.md. Easy Diffusion,
# AUTOMATIC1111, ComfyUI and others each need a small adapter in front — deliberately, so this
# application carries no GPU or Python assumptions.
LOCAL_AI_IMAGE_URL=
LOCAL_AI_IMAGE_API_KEY=
LOCAL_AI_IMAGE_TIMEOUT_MS=300000
# [optional] OpenAI-compatible local LLM. The only text route ZERO_COST can reach.
LOCAL_AI_LLM_URL=
LOCAL_AI_LLM_API_KEY=
LOCAL_AI_LLM_MODEL=


# ─── RENDERING ───────────────────────────────────────────────────────────────
# [optional] External HyperFrames-compatible service. Unset, the built-in headless-Chromium
# compositor is used instead. FFmpeg is never replaced by either.
HYPERFRAMES_URL=
HYPERFRAMES_FPS=30


# ─── BROWSER AUTOMATION ──────────────────────────────────────────────────────
# [optional] Set to 1 on Vercel ONLY. The app build never needs Chromium — no Playwright code is
# reachable from a Vercel-hosted route (core/queue/worker-only-processors.ts). Leave unset on the
# worker host, where you instead run `npx playwright install --with-deps chromium` once.
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
# [optional] "false" runs a visible browser. Useful when recalibrating selectors locally.
PLAYWRIGHT_HEADLESS=true
# [optional] Hard cap on AI-agent actions in one workflow run — the kill switch against a runaway
# loop. Default 100.
MAX_AI_ACTIONS=100
# [optional] Comma-separated domains the AI agent may navigate to. Empty means no allowlist is
# enforced; set it in production.
AI_ALLOWED_DOMAINS=


# ─── INSTAGRAM (optional) ────────────────────────────────────────────────────
# [optional] Official Meta Graph API only — no browser automation, no unsolicited outreach.
# Replying to real customers (not just added testers) needs Meta App Review approval for
# instagram_manage_messages, which happens in the Meta dashboard, outside this codebase.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=v21.0


# ─── OBSERVABILITY ───────────────────────────────────────────────────────────
# [optional] "debug" | "info" | "warn" | "error". Default info.
# Logs are structured and never contain secret values — see core/security/encryption.ts#redactSecrets.
LOG_LEVEL=info
