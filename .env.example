# ── App ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=            # openssl rand -base64 32

# ── Google OAuth (app login, via Auth.js) ───────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Google Account Manager (generation-account token encryption) ───────
ACCOUNTS_ENCRYPTION_KEY=    # openssl rand -hex 32 (AES-256-GCM key for stored OAuth tokens)

# ── MongoDB Atlas ────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai-video-studio

# ── Cloudinary ───────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Upstash Redis (BullMQ) ───────────────────────────────────────────────
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# ── Queue tick runtime (see ARCHITECTURE.md §7) ─────────────────────────
QUEUE_TICK_BUDGET_MS=45000
# Vercel automatically sends `Authorization: Bearer $CRON_SECRET` on its own Cron requests when a
# project env var of this exact name is set — reuse it for the fire-and-forget self-call too.
CRON_SECRET=

# ── AI provider defaults (bootstrap; overridable per-user in Settings) ──
AI_STORY_PROVIDER=gemini
AI_IMAGE_PROVIDER=gemini
AI_VIDEO_PROVIDER=google-flow
AI_VOICE_PROVIDER=gemini

GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ── Browser Automation Engine (worker.ts only — see docs/MOVIE-STUDIO-ROADMAP.md Module 4) ─────
# Set on Vercel (the app build never needs Chromium — the automation code isn't reachable from any
# Vercel-hosted route, see core/queue/worker-only-processors.ts). Leave unset on the worker.ts host,
# where you instead run `npx playwright install --with-deps chromium` once during setup.
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
